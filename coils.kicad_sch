			)
			(justify left top)
		)
		(uuid "04da0eab-e251-47b5-8a82-79a0130c571b")
	)
	(text "J2/J3: 2x6 2.54 mm male headers on the BOTTOM side at the coil exits.\nMate with the signal-board sockets J2/J3 (same pinout). GND comes from\nthe signal board; it only shields the pairs inside the connector."
		(exclude_from_sim no)
		(at 150 140 0)
