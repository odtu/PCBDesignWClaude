	(text "ENCODER CONNECTOR  J1 (2x6, 2.54 mm)"
		(exclude_from_sim no)
		(at 30 30 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "0a695bc6-66b9-420f-a85d-89c286916043")
	)
	(text "Pinout\n 1,2  +VIN 12-24 V        3,4,11  GND\n 5  UART_RX (host -> encoder)   6  UART_TX (encoder -> host)\n 7  SYNC (sample trigger in)     8  NRST\n 9  SWDIO   10  SWCLK   12  +3V3 (debugger VTref, out)\nUART: 2.5 Mbaud, 8N1 (TIDA-010961 protocol). The MSPM0 ROM bootloader\nalso uses UART0 (PA10/PA11): hold BSL (PA18) high at reset to flash over J1."
		(exclude_from_sim no)
		(at 30 130 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "01e5d9c5-89f4-43d2-bf4e-47a3f240002b")
	)
	(text "LAYOUT: J1 on the bottom side (away from the target), at the board edge."
		(exclude_from_sim no)
		(at 30 175 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "117b676e-d8e8-429b-b10c-935350ae7ed0")
	)
