	(text "INDUCTIVE ENCODER - SIGNAL BOARD  (rev A)"
		(exclude_from_sim no)
		(at 15 15 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "319657e8-b185-491b-adf1-6582e636db71")
	)
	(text "Contactless absolute rotary encoder after TI TIDA-010961 (TIDUFF8).\nDual-track Nonius coils (16 / 15 periods) on a 4-layer Ø76 mm stator, Ø56 mm\ncopper target disc, 0.5 mm air gap. Two LDC5072-Q1 AFEs excite the coils and\ndemodulate sin/cos; MSPM0G3507 samples both ADCs simultaneously and computes\nthe absolute angle (Nonius sector + fine angle), sent over UART."
		(exclude_from_sim no)
		(at 15 24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "66f2df10-7043-4e12-a281-6f6c68a0dc24")
	)
	(text "KEY SPECS\nInput: 12-24 V (4-65 V buck), ~0.5 W\nCoil area: Ø58 mm, shaft hole Ø16 mm\nTracks: 16 periods (outer), 15 periods (inner)\nExcitation: ~4.7 MHz (outer), ~3.85 MHz (inner)\nMCU: MSPM0G3507, 2x 12-bit 4 Msps ADC\nInterface: UART 2.5 Mbaud, SYNC input, SWD\nTarget accuracy (TI ref.): < 0.04°, 16+ ENOB"
		(exclude_from_sim no)
		(at 15 55 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "862e824b-9789-46a5-aed9-c758f495ad7c")
	)
	(text "Stator coils (generated)"
